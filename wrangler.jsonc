{
  // Cloudflare Workers 배포 설정. 이 파일이 없으면 빌드가 정적 파일만 올리는 설정을 자동으로 만든다.
  // /api/* 는 worker/index.js 가 먼저 처리하고, 나머지는 정적 파일을 그대로 준다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yenajun-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "observability": { "enabled": true },
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
